# 복사해서 .env 로 쓰세요. .env 는 커밋되지 않습니다.

# 대상 캘린더 id — Google Calendar > 캘린더 설정 > '캘린더 통합' 에 있습니다.
# 보통 ...@group.calendar.google.com 형태입니다.
GOOGLE_CALENDAR_ID=

# 서비스 계정 키 JSON 전문(한 줄). GitHub Actions 에서는 Secret 으로 넣습니다.
# 로컬에서는 GOOGLE_SERVICE_ACCOUNT_FILE 로 파일 경로를 줘도 됩니다.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# 사람인 Open API access-key — 이용신청 승인 후 [Application] > [내 앱리스트] 에서 확인
SARAMIN_ACCESS_KEY=
